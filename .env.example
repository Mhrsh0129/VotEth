# ========================================
# Voting DApp — Environment Variables
# ========================================
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Blockchain ---
# Sepolia RPC URL (Alchemy or other provider)
API_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# Admin/deployer wallet private key (without 0x prefix)
# ⚠️  NEVER commit real private keys to git!
PRIVATE_KEY="your_wallet_private_key_here"

# Deployed contract address (auto-updated by deploy-and-update.js)
CONTRACT_ADDRESS="0xYourDeployedContractAddress"

# --- Face Verification Service ---
# Private key for signing face verification messages (with 0x prefix)
# If not set, an ephemeral key is generated (NOT suitable for production)
SIGNER_PRIVATE_KEY="0xYourSignerPrivateKeyHere"

# Encryption key for face embeddings stored in the database
DB_ENCRYPTION_KEY="your_32_byte_hex_encryption_key_here"

# JWT secret for face verification tokens
# ⚠️  MUST be changed from default for production!
JWT_SECRET_KEY="your_strong_random_secret_here"

# --- Optional ---
# Election duration in minutes (used by start.js)
# ELECTION_DURATION=60
